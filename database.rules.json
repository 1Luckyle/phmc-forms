{
  "rules": {

    // ═══════════════════════════════════════════════════════════════════════════
    // COMMENT UTILISER CES RÈGLES
    // ───────────────────────────────────────────────────────────────────────────
    // La vérification admin se base sur le nœud "adminUIDs" (map UID → true).
    // ÉTAPE OBLIGATOIRE avant de déployer :
    //   1. Aller sur console.firebase.google.com → Authentication
    //   2. Copier l'UID de chaque compte admin
    //   3. Dans Realtime Database, créer manuellement :
    //        adminUIDs: {
    //          "UID_ADMIN_1": true,
    //          "UID_ADMIN_2": true
    //        }
    //   4. Déployer ces règles : firebase deploy --only database
    // ═══════════════════════════════════════════════════════════════════════════

    // ─── Map des admins (clé = Firebase Auth UID → true) ─────────────────────
    // Source de vérité pour toutes les règles admin.
    // Lisible par tout utilisateur connecté (nécessaire pour les vérifications côté app).
    // Modifiable uniquement par un admin existant.
    "adminUIDs": {
      ".read":  "auth != null",
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
    },

    // ─── Liste admin legacy (emails/UIDs en array) ────────────────────────────
    // Conservée pour la compatibilité côté app. Écrite uniquement par les admins.
    "adminUsers": {
      ".read":  "auth != null",
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
    },

    // ─── Listes du personnel ──────────────────────────────────────────────────
    // Lecture publique : les sélecteurs d'employés dans les formulaires sont
    // accessibles à tous (civils, recrutement, etc.).
    // Écriture : admins uniquement.
    //
    // Auto-édition du profil : chaque membre peut modifier SEUL son téléphone (phNumber) et son
    // Discord sur SA fiche (uid de la fiche === auth.uid). Nom, grade, badge et e-mail restent
    // réservés aux admins ; l'e-mail ne change que via les Cloud Functions requestStaffEmailChange /
    // confirmStaffEmailChange (code envoyé à la nouvelle adresse), qui contournent ces règles.
    "staff": {
      ".read":  true,
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true",
      "phmc": {
        "$key": {
          "name": {
            ".write": "auth != null && root.child('staff').child('phmc').child($key).child('uid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "firstName": {
            ".write": "auth != null && root.child('staff').child('phmc').child($key).child('uid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "lastName": {
            ".write": "auth != null && root.child('staff').child('phmc').child($key).child('uid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "phNumber": {
            ".write": "auth != null && root.child('staff').child('phmc').child($key).child('uid').val() === auth.uid",
            ".validate": "(newData.isString() && newData.val().length <= 40) || newData.isNumber()"
          },
          "discord": {
            ".write": "auth != null && root.child('staff').child('phmc').child($key).child('uid').val() === auth.uid",
            ".validate": "(newData.isString() && newData.val().length <= 64) || newData.isNumber()"
          }
        }
      },
      "coroner": {
        "$key": {
          "name": {
            ".write": "auth != null && root.child('staff').child('coroner').child($key).child('uid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "firstName": {
            ".write": "auth != null && root.child('staff').child('coroner').child($key).child('uid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "phNumber": {
            ".write": "auth != null && root.child('staff').child('coroner').child($key).child('uid').val() === auth.uid",
            ".validate": "(newData.isString() && newData.val().length <= 40) || newData.isNumber()"
          },
          "discord": {
            ".write": "auth != null && root.child('staff').child('coroner').child($key).child('uid').val() === auth.uid",
            ".validate": "(newData.isString() && newData.val().length <= 64) || newData.isNumber()"
          }
        }
      }
    },

    // ─── Options des formulaires & agences ───────────────────────────────────
    // Les postes de recrutement sont stockés dans les nœuds postes* (FRANÇAIS : nom, statut OUVERT/FERMÉ,
    // presentation…) ; les anciens nœuds anglais (physicianRecruitmentDetails…) gardent les mêmes droits jusqu'à
    // leur nettoyage. Les postes de recrutement (statut OUVERT/FERMÉ, description…) sont aussi gérés
    // par les RECRUTEURS (recruiterUIDs, posé par un admin) : ils n'ont accès en écriture
    // qu'à ces six nœuds, pas au reste de selectOptions, et peuvent AJOUTER ou MODIFIER un
    // poste mais jamais en supprimer un (newData.exists()) : le renommage d'une clé de poste
    // (= supprimer l'ancienne clé) reste donc réservé aux admins.
    "selectOptions": {
      ".read":  true,
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true",
      "physicianRecruitmentDetails": { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } },
      "psychPositionDetailsData":    { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } },
      "adminPositionDetailsData":    { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } },
      "nursePositionDetailsData":    { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } },
      "emsPositionDetailsData":      { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } },
      "coronerPositionDetailsData":  { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } },
      "postesMedecine":                 { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } },
      "postesPsychologie":              { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } },
      "postesAdministration":           { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } },
      "postesSoinsInfirmiers":          { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } },
      "postesParamedical":              { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } },
      "postesMedecineLegale":           { "$positionKey": { ".write": "auth != null && (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.exists()" } }
    },

    // ─── Rôle « recruteur » ───────────────────────────────────────────────────
    // recruiterUIDs/{uid}: true — posé/retiré par un admin (menu de gestion des
    // utilisateurs). Un recruteur reste un compte Civil ; ce drapeau lui ajoute l'onglet
    // Recrutement de la boîte à outils. Lisible par tout utilisateur connecté (l'app
    // vérifie son propre uid au chargement).
    "recruiterUIDs": {
      ".read":  "auth != null",
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
    },

    // ─── Droit « Recruteur » (nouveau nom de recruiterUIDs) ───────────────────
    // recruteurs/{uid}: true — posé/retiré par un admin. recruiterUIDs reste reconnu tant que la migration
    // « Recrutement en français » n'a pas déplacé les drapeaux (voir les règles qui testent les deux).
    "recruteurs": {
      ".read":  "auth != null",
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
    },

    // ─── Mes créations (carte de visite + signature) ─────────────────────────────
    // userCreations/{uid}/businessCard | signature : { url, deleteUrl, createdAt, ... }.
    // Une seule de chaque par personne ; lisible / modifiable par son propriétaire et les admins.
    "userCreations": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('adminUIDs').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('adminUIDs').child(auth.uid).val() === true)"
      }
    },

    // ─── File des images ImgBB à supprimer ───────────────────────────────────────
    // ImgBB n'a pas d'API de suppression : quand quelqu'un remplace / supprime sa carte ou sa
    // signature, le lien de suppression ImgBB est ajouté ici. Tout utilisateur connecté peut AJOUTER
    // une entrée (lien ibb.co uniquement) ; seuls les admins la lisent et la retirent (panneau admin
    // → Images à supprimer).
    "imgbbDeleteQueue": {
      ".read":  "root.child('adminUIDs').child(auth.uid).val() === true",
      "$entryId": {
        ".write": "auth != null && ((!data.exists() && newData.exists()) || root.child('adminUIDs').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['deleteUrl', 'queuedAt']) && newData.child('deleteUrl').isString() && newData.child('deleteUrl').val().matches(/^https:\\/\\/ibb\\.co\\/.+/)"
      }
    },

    "agencies": {
      ".read":  true,
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
    },

    // ─── Paramètres admin (lockdown, config) ──────────────────────────────────
    // Lockdown doit être lu par tout le monde (LockdownContext / useDeploymentConfig).
    "adminSettings": {
      ".read":  true,
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
    },

    // ─── Statut des services (bandeaux, disponibilité) ────────────────────────
    "serviceStatus": {
      ".read":  true,
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
    },

    // ─── Demandes de création de compte en attente ────────────────────────────
    // Écriture PUBLIQUE : la demande est soumise AVANT la création du compte
    // Firebase Auth (flux onboarding pré-authentification).
    // Lecture : admins uniquement.
    "pendingAccountRequests": {
      ".read":  "root.child('adminUIDs').child(auth.uid).val() === true",
      ".write": true
    },

    // ─── Demandes de modification en attente ──────────────────────────────────
    // Soumises par les employés authentifiés, lues uniquement par les admins.
    "pendingModificationRequests": {
      ".read":  "root.child('adminUIDs').child(auth.uid).val() === true",
      ".write": "auth != null"
    },

    // ─── Rapports sauvegardés ─────────────────────────────────────────────────
    // Admin : lecture complète du nœud (UserStats, UserManagementModal).
    // Sauvegarder un rapport nécessite désormais toujours d'être connecté (voir
    // handleSaveReportWrapper dans MainApp.js : plus de sauvegarde anonyme).
    // CIVILIAN : ancien compartiment des formulaires civils sauvegardés de
    // façon anonyme (abandonné, invisible depuis l'interface) — lecture encore
    // publique pour les anciennes données déjà présentes, mais plus aucune
    // nouvelle écriture anonyme n'y est permise.
    "savedReports": {
      ".read":  "root.child('adminUIDs').child(auth.uid).val() === true",
      "CIVILIAN": {
        ".read":  true,
        ".write": "auth != null"
      },
      "$userKey": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    // ─── Bingo ────────────────────────────────────────────────────────────────
    "bingo": {
      // Listes de phrases maîtres — lu par les connectés, écrit par admin
      "phrases": {
        ".read":  "auth != null",
        ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
      },
      // Cartes de bingo — lu par les connectés, généré par admin uniquement
      "cards": {
        ".read":  "auth != null",
        ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
      },
      // Logs d'activité — lu & écrit par les employés connectés (cocher les cases)
      "logs": {
        ".read":  "auth != null",
        ".write": "auth != null"
      },
      // Demandes de phrases — soumises par les connectés, lues par admin
      "phraseRequests": {
        ".read":  "root.child('adminUIDs').child(auth.uid).val() === true",
        ".write": "auth != null"
      }
    },

    // ─── Logs webhook ─────────────────────────────────────────────────────────
    "webhook_logs": {
      ".read":  "root.child('adminUIDs').child(auth.uid).val() === true",
      ".write": "auth != null"
    },

    // ─── Configurations webhook ───────────────────────────────────────────────
    "webhooks": {
      ".read":  "root.child('adminUIDs').child(auth.uid).val() === true",
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
    },

    // ─── Sauvegardes de migration ─────────────────────────────────────────────
    "migrationBackups": {
      ".read":  "root.child('adminUIDs').child(auth.uid).val() === true",
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
    },

    // ─── Profils Civil ─────────────────────────────────────────────────────────
    // Identité + coordonnées d'un compte Civil (voir EmployeeAuthContext.js,
    // branche civilianProfile), SANS AUCUN champ de santé. Lecture par tout
    // personnel PHMC/DMEC connecté (décision validée : n'importe quel personnel
    // connecté peut voir/partager/copier le dossier d'un patient — voir Lot 5 du
    // plan Civil), et par le civil lui-même. Écriture : le civil sur son propre
    // profil, OU un admin sur n'importe quel profil (voir ManageCivilians.js —
    // modifier/supprimer un compte Civil comme admin échouait avec
    // PERMISSION_DENIED tant que seul auth.uid === $uid était autorisé).
    "civilians": {
      // .read au niveau du parent (pas seulement $uid) : generatePatientID()
      // dans EmployeeAuthContext.js lit tout le nœud civilians pour vérifier
      // l'absence de collision d'ID patient (get(ref(database, 'civilians'))).
      // Une règle .read définie uniquement sous $uid n'autorise PAS la lecture
      // du nœud parent — Firebase exige la permission au niveau exact du chemin
      // lu, elle ne "descend" pas automatiquement depuis les enfants. Sans ce
      // niveau, generatePatientID() échoue avec PERMISSION_DENIED et bloque
      // toute création de compte Civil après l'étape de vérification d'email.
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('adminUIDs').child(auth.uid).val() === true)"
      }
    },

    // ─── Index des dossiers par patient (regroupement, Lot 5) ─────────────────
    // patientRecords/{patientID}/{indexKey} : pointeurs (reportPath +
    // visibility: owner/shared/staff-only) vers les vrais rapports dans
    // savedReports, écrits par saveReport() dès que formData.patientID est
    // renseigné. Lecture : même modèle que savedReports (auth != null — tout
    // utilisateur authentifié, cohérent avec le reste de l'app ; la vue Civil
    // elle-même ne consulte jamais que son propre patientID côté client).
    // Écriture : tout utilisateur connecté peut créer/mettre à jour une entrée
    // (sauvegarder un rapport, le partager, marquer une copie). La SUPPRESSION
    // (newData.exists() faux) est permise : aux admins, à tout membre du
    // personnel (un utilisateur qui n'a PAS de profil dans civilians — il supprime
    // ses rapports ou ses copies depuis « Rapports enregistrés » / « Dossier
    // Patient »), et à un civil uniquement pour une entrée qu'il a lui-même
    // créée (visibility "owner"). Un civil ne peut donc jamais supprimer un
    // rapport créé par le personnel ; les règles métier plus fines (copie
    // conservée par un médecin, etc.) sont appliquées côté application — voir
    // deleteReportWithRules dans src/utils/patientRecords.js.
    "patientRecords": {
      // Lecture de TOUT le nœud (liste des patients sans compte dans « Dossier
      // Patient », réindexation admin) : personnel et admins uniquement — un civil
      // ne peut lire que le dossier d'un ID précis (règle $patientId ci-dessous).
      ".read": "auth != null && !root.child('civilians').child(auth.uid).exists()",
      "$patientId": {
        ".read": "auth != null",
        "$indexKey": {
          ".write": "auth != null && (newData.exists() || root.child('adminUIDs').child(auth.uid).val() === true || !root.child('civilians').child(auth.uid).exists() || data.child('visibility').val() === 'owner')"
        }
      }
    },

    // ─── Pipeline de candidatures (Lot 6) ──────────────────────────────────────
    // jobApplications/{applicantUid}/{applicationId} — une entrée par
    // combinaison civil/poste (applicationId dérivé du bbCodeVersion). Même
    // modèle de règles que patientRecords : lecture par tout utilisateur
    // authentifié (le panneau admin lit tout l'arbre ; la vue Civil ne
    // consulte que jobApplications/{son propre uid}) ; écriture par tout
    // utilisateur connecté (le civil gère sa propre candidature, l'admin fait
    // avancer son statut) ; suppression réservée aux admins.
    // .read déclaré ici (niveau parent), pas seulement sous $applicantUid :
    // PendingJobApplications.js lit tout le nœud jobApplications en une fois
    // (get(ref(database, 'jobApplications'))) pour les aplatir dans le panneau
    // admin — une règle .read placée uniquement sous $applicantUid n'aurait
    // pas autorisé cette lecture globale (voir la même correction sur civilians).
    "jobApplications": {
      ".read": "auth != null",
      "$applicantUid": {
        "$applicationId": {
          // Suppression : admins ; recruteurs et candidats (pour LEURS candidatures)
          // uniquement tant que l'interrupteur Debug « suppression des candidatures » est
          // activé dans le panneau admin (adminSettings/debugDeleteApplications).
          ".write": "auth != null && (newData.exists() || root.child('adminUIDs').child(auth.uid).val() === true || (((root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) || auth.uid === $applicantUid) && root.child('adminSettings').child('debugDeleteApplications').child('enabled').val() === true))"
        }
      }
    },

    // ─── Candidatures (nouveau nom de jobApplications) ────────────────────────
    // candidatures/{candidatUid}/{candidatureId} — mêmes droits que jobApplications (lecture par tout
    // connecté, écriture par tout connecté, suppression réservée aux admins ; recruteurs et candidats ne
    // suppriment les leurs que si le mode Debug « suppression des candidatures » est actif). Les champs
    // sont en français (statut : brouillon, soumise, entretien_programme, entretien_effectue, acceptee,
    // refusee, retiree, en_pause). L'ancien nœud jobApplications reste lu jusqu'à sa migration.
    "candidatures": {
      ".read": "auth != null",
      "$candidatUid": {
        "$candidatureId": {
          ".write": "auth != null && (newData.exists() || root.child('adminUIDs').child(auth.uid).val() === true || (((root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) || auth.uid === $candidatUid) && root.child('adminSettings').child('debugDeleteApplications').child('enabled').val() === true))"
        }
      }
    },

    // ─── Paiements Fleeca (passerelle marchand v2) ────────────────────────────
    // Créés et mis à jour uniquement côté serveur avec le SDK Admin (voir
    // createFleecaPayment / fleecaWebhook / getFleecaPaymentStatus dans
    // functions/index.js), qui contourne ces règles : ".write": false bloque
    // donc uniquement les tentatives d'écriture directe depuis le client
    // (falsification du statut d'un paiement).
    // Lecture publique : les formulaires concernés (civils compris) doivent
    // pouvoir suivre en direct le statut de leur paiement sans être connectés.
    "fleecaPayments": {
      ".read":  true,
      ".write": false
    },

    // ─── Factures patient (rapports médicaux civils payants) ──────────────────
    // facturesPatients/{ID patient}/{clé du rapport} : créée par le navigateur à la sauvegarde d'un rapport
    // facturé (voir src/utils/patientInvoices.js). Lecture : le dossier d'un ID précis par tout connecté
    // (le civil ne lit que le sien côté client), le nœud entier par le personnel et les admins.
    // Écriture : n'importe quel connecté peut CRÉER une facture (jamais directement « paye ») ; seuls le
    // personnel et les admins peuvent ensuite la modifier ou la supprimer, et personne côté client ne peut
    // passer une facture à « paye » ni la ramener en arrière : le règlement est fait par le serveur
    // (webhook Fleeca / getFleecaPaymentStatus), qui contourne ces règles.
    "facturesPatients": {
      ".read": "auth != null && !root.child('civilians').child(auth.uid).exists()",
      "$patientId": {
        ".read": "auth != null",
        "$factureId": {
          ".write": "auth != null && (newData.exists() ? ((!data.exists() && newData.child('statut').val() !== 'paye') || ((root.child('adminUIDs').child(auth.uid).val() === true || !root.child('civilians').child(auth.uid).exists()) && ((data.child('statut').val() === 'paye') === (newData.child('statut').val() === 'paye')))) : (root.child('adminUIDs').child(auth.uid).val() === true || !root.child('civilians').child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['montant', 'statut', 'creeLe']) && newData.child('montant').isNumber() && (newData.child('statut').val() === 'a_payer' || newData.child('statut').val() === 'paye' || newData.child('statut').val() === 'sans_paiement')"
        }
      }
    },

    // File des factures à payer (mails groupés + rappel quotidien), lue uniquement par le serveur.
    "facturesEnAttente": {
      ".read":  false,
      "$patientId": {
        "$factureId": {
          ".write": "auth != null"
        }
      }
    },

    // ─── Codes de vérification d'email (Eyefind Mail) ─────────────────────────
    // Créés/lus/mis à jour exclusivement côté serveur avec le SDK Admin (voir
    // sendEmailVerificationCode / verifyEmailCode / createGtawCivilianAccount
    // dans functions/index.js), qui contourne ces règles : lecture et écriture
    // client bloquées pour empêcher qu'un civil ne s'auto-valide un code ou ne
    // lise celui d'un autre.
    "emailVerifications": {
      ".read":  false,
      ".write": false
    },

    // ─── Demandes de changement d'adresse du personnel ────────────────────────
    // emailChangeRequests/{uid} : nouvelle adresse + code de vérification à 6 chiffres. Gérées
    // exclusivement côté serveur (requestStaffEmailChange / confirmStaffEmailChange) : lecture et
    // écriture client bloquées pour que personne ne puisse lire le code ni se l'auto-valider.
    "emailChangeRequests": {
      ".read":  false,
      ".write": false
    },

    // ─── Contrats de travail (FRANÇAIS) ───────────────────────────────────────
    // contrats/{id} : contrat rattaché à un membre du personnel, un recruteur ou un candidat accepté
    // (employeUid), statut brouillon -> envoye -> signe (voir src/utils/contracts.js).
    //   • Lecture de TOUT le nœud : admins et recruteurs. Un employé ne lit que SES contrats déjà envoyés
    //     (jamais un brouillon), un par un, via l'index contratsParEmploye.
    //   • Écriture : admins sans restriction ; recruteurs tant que le contrat n'est pas signé, sans jamais
    //     pouvoir poser le statut « signe » (seul l'employé signe) et sans pouvoir créer ni modifier leur
    //     PROPRE contrat (employeUid === leur uid) : c'est un admin ou un autre recruteur qui s'en charge.
    //   • Signature : l'employé destinataire pose signature + signeLe + statut « signe », uniquement depuis
    //     « envoye » et uniquement avec l'image de SA signature enregistrée (userCreations/{uid}/signature).
    "contrats": {
      ".read": "auth != null && (root.child('adminUIDs').child(auth.uid).val() === true || (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true))",
      "$contractId": {
        ".read": "auth != null && data.child('employeUid').val() === auth.uid && data.child('statut').val() !== 'brouillon'",
        ".write": "auth != null && (root.child('adminUIDs').child(auth.uid).val() === true || ((root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && newData.child('statut').val() !== 'signe' && (!data.exists() || data.child('statut').val() !== 'signe') && newData.child('employeUid').val() !== auth.uid && data.child('employeUid').val() !== auth.uid))",
        ".validate": "newData.hasChildren(['employeUid', 'statut']) && (newData.child('statut').val() === 'brouillon' || newData.child('statut').val() === 'envoye' || newData.child('statut').val() === 'signe')",
        "statut": {
          ".write": "auth != null && data.parent().child('employeUid').val() === auth.uid && data.val() === 'envoye' && newData.val() === 'signe' && newData.parent().child('signature').child('url').exists()"
        },
        "signature": {
          ".write": "auth != null && data.parent().child('employeUid').val() === auth.uid && data.parent().child('statut').val() === 'envoye' && !data.exists() && newData.child('signeParUid').val() === auth.uid",
          ".validate": "newData.child('url').val() === root.child('userCreations').child(auth.uid).child('signature').child('url').val() && (!newData.child('imageData').exists() || (newData.child('imageData').isString() && newData.child('imageData').val().length <= 300000))"
        },
        "signeLe": {
          ".write": "auth != null && data.parent().child('employeUid').val() === auth.uid && data.parent().child('statut').val() === 'envoye' && !data.exists()"
        }
      }
    },

    // Index « mes contrats » : contratsParEmploye/{uid}/{contractId}: true, posé à l'envoi du contrat et
    // retiré s'il est retiré/supprimé. Lisible par l'employé concerné et les admins ; un recruteur ne peut pas
    // s'y ajouter lui-même.
    "contratsParEmploye": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('adminUIDs').child(auth.uid).val() === true)",
        "$contractId": {
          ".write": "auth != null && (root.child('adminUIDs').child(auth.uid).val() === true || ((root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && $uid !== auth.uid))"
        }
      }
    },

    // Rôle facultatif « en attente de signature de contrat » : candidatsContrat/{uid} = { definiPar,
    // definiParNom, definiLe, candidatureId, poste, role }. Posé et retiré par les admins et recruteurs sur le
    // compte Civil d'un candidat accepté ; lisible par le titulaire (son propre uid).
    "candidatsContrat": {
      ".read": "auth != null && (root.child('adminUIDs').child(auth.uid).val() === true || (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true))",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('adminUIDs').child(auth.uid).val() === true || ((root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true) && $uid !== auth.uid))"
      }
    },

    // ─── Anciens nœuds de contrats (anglais) : migration et nettoyage uniquement ──
    // Remplacés par contrats / contratsParEmploye. contractCandidates reste LU par les recruteurs et son
    // titulaire tant que la migration n'a pas été faite (rôle « en attente de contrat » déjà posé).
    "contracts": {
      ".read":  "root.child('adminUIDs').child(auth.uid).val() === true",
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
    },
    "contractsByEmployee": {
      ".read":  "root.child('adminUIDs').child(auth.uid).val() === true",
      ".write": "root.child('adminUIDs').child(auth.uid).val() === true"
    },
    "contractCandidates": {
      ".read": "auth != null && (root.child('adminUIDs').child(auth.uid).val() === true || (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true))",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('adminUIDs').child(auth.uid).val() === true || (root.child('recruteurs').child(auth.uid).val() === true || root.child('recruiterUIDs').child(auth.uid).val() === true))"
      }
    }
  }
}
